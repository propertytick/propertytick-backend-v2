# ===== SERVER =====
NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:3000

# ===== DATABASE =====
MONGO_URI=mongodb://localhost:27017/bhoomi_link

# ===== JWT =====
JWT_SECRET=change_this_super_secret_key_min_64_chars_long_please_change
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=change_this_refresh_secret_key_also_64_chars_long
JWT_REFRESH_EXPIRE=30d

# ===== ENCRYPTION =====
ENCRYPTION_KEY=32_char_aes_key_change_this_now_123

# ===== OTP / SMS (MSG91) =====
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=BHOOMI
MSG91_TEMPLATE_ID=your_template_id

# ===== WHATSAPP (Twilio) =====
TWILIO_ACCOUNT_SID=your_sid
TWILIO_AUTH_TOKEN=your_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ===== CLOUDINARY =====
CLOUDINARY_CLOUD_NAME=your_cloud
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret

# ===== RAZORPAY =====
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx

# ===== DIGILOCKER KYC =====
DIGILOCKER_CLIENT_ID=your_id
DIGILOCKER_CLIENT_SECRET=your_secret

# ===== ADMIN SEED =====
ADMIN_EMAIL=admin@propertytick.com
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=Admin@123456
